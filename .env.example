# Klaviyo API Configuration

# Public API Key (Site ID) - for client subscriptions
KLAVIYO_PUBLIC_API_KEY=your_public_api_key_here

# Private API Key - for updating profile details (starts with pk_)
KLAVIYO_API_KEY=pk_your_private_api_key_here

# Klaviyo List ID
KLAVIYO_LIST_ID=QNsiQA

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Stock Seeding
STOCK_SEED_SECRET=your_seed_secret_here
