APP_NAME="Ferguson Livestock"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Canonical origin used in canonical tags, sitemaps and structured data.
SHOP_URL=https://www.fergusonlivestock.com.au

# Postgres locally (Herd: user "root", no password). Laravel Cloud injects DB_* per environment.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ferguson_livestock
DB_USERNAME=root
DB_PASSWORD=

# Redis locally; Laravel Valkey on Cloud (set CACHE_STORE and SESSION_DRIVER to redis there too).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
# CACHE_PREFIX=

# Laravel Cloud's managed queue sets QUEUE_CONNECTION=cloud.
QUEUE_CONNECTION=redis

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Stripe test-mode keys locally; live keys only in production.
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# The only person who can sign in to /admin.
SHOP_ADMIN_EMAIL=
# Their mobile (+614...), for test texts of broadcasts.
SHOP_ADMIN_PHONE=

# Twilio sends and receives wait-list texts from the shop's 04xx number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Mail goes to the log locally. Cloud uses MAIL_MAILER=resend with RESEND_API_KEY.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="orders@send.fergusonlivestock.com.au"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

VITE_APP_NAME="${APP_NAME}"
