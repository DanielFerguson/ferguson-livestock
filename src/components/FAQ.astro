---
import { business } from "../config/business";
import { bundles, formatAud, products } from "../config/products";

interface Props {
    headingLevel?: 1 | 2;
}

const { headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 1 ? "h1" : "h2";

const fiveKgBox = products["beef-box-5kg"];
const tenKgBox = bundles["beef-box-10kg"];
const delivery = products[business.delivery.feeProductId];

const faqs = [
    {
        question: "How does ordering work?",
        answer: "When a drop opens, choose a 5kg or 10kg box, add any available individual cuts, select delivery or farm pickup, and complete payment securely through Stripe. If boxes are sold out, you can still order any individual cuts showing as available.",
    },
    {
        question: "How much do the beef boxes cost?",
        answer: `${fiveKgBox.name} boxes are ${formatAud(fiveKgBox.price)} (${formatAud(fiveKgBox.boxDetails!.perKgPrice)}/kg), and ${tenKgBox.name} boxes are ${formatAud(tenKgBox.displayPrice)} (${formatAud(tenKgBox.boxDetails.perKgPrice)}/kg).`,
    },
    {
        question: "What cuts are included?",
        answer: "Each box contains a balanced mix of primary steaks, secondary and slow-cook cuts, roast, sausages and mince. Because each animal is different, the exact cuts and individual pack weights vary while the total box weight remains the same.",
    },
    {
        question: "Can I buy individual cuts?",
        answer: "Yes. Mince, bones, sausages, rump, porterhouse and diced chuck may be offered individually when stock is available. The order page always shows the current range and quantity remaining.",
    },
    {
        question: "Where do you deliver?",
        answer: `We personally deliver across the ${business.delivery.areaName}. Delivery is ${formatAud(delivery.price)} per order. ${business.pickup.label} is also available ${business.location.proximity}.`,
    },
    {
        question: "How is the beef raised?",
        answer: "Our Murray Grey cattle are pasture-raised on our Snake Valley farm. We are documenting the finer details of our feeding and husbandry practices so customers can see exactly what each claim means rather than relying on broad marketing labels.",
    },
    {
        question: "How is the beef processed and packed?",
        answer: "The cattle are processed through a licensed local facility, and the cuts are professionally prepared and vacuum-sealed before collection or personal delivery. We will publish the confirmed processing and conditioning details as part of our full provenance guide.",
    },
    {
        question: "What happens when a drop sells out?",
        answer: "Join the wait list and we will text you when the next beef-box drop opens. If individual cuts remain after the boxes sell out, they stay available on the order page while stock lasts.",
    },
];

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
            "@type": "Answer",
            text: faq.answer,
        },
    })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="bg-cream py-16 lg:py-24">
    <div class="mx-auto max-w-6xl px-6">
        <div class="mb-12 text-center lg:mb-16">
            <span class="mb-4 inline-block text-xs font-semibold uppercase tracking-widest text-sage">Good to know</span>
            <Heading class="mb-4 font-display text-3xl font-semibold tracking-tight text-forest md:text-4xl lg:text-5xl">
                Frequently asked questions
            </Heading>
            <p class="mx-auto max-w-xl text-lg text-gray-600">
                Straight answers about boxes, delivery and ordering.
            </p>
        </div>

        <div class="mx-auto max-w-3xl space-y-4" role="list">
            {faqs.map((faq, index) => (
                <div class="faq-item overflow-hidden border border-forest/10 bg-white" role="listitem">
                    <button
                        class="faq-question flex w-full cursor-pointer items-center justify-between gap-4 border-0 bg-transparent px-6 py-5 text-left text-lg font-semibold text-forest transition-colors hover:text-sage"
                        aria-expanded="false"
                        aria-controls={`faq-answer-${index}`}
                        id={`faq-question-${index}`}
                    >
                        {faq.question}
                        <svg class="faq-icon h-6 w-6 shrink-0 fill-sage transition-transform" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                        </svg>
                    </button>
                    <div
                        class="faq-answer"
                        id={`faq-answer-${index}`}
                        role="region"
                        aria-labelledby={`faq-question-${index}`}
                        hidden
                    >
                        <div class="px-6 pb-6 leading-relaxed text-gray-600">{faq.answer}</div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
    document.querySelectorAll<HTMLButtonElement>(".faq-question").forEach((button) => {
        button.addEventListener("click", () => {
            const item = button.closest(".faq-item");
            const answerId = button.getAttribute("aria-controls");
            const answer = answerId ? document.getElementById(answerId) : null;
            if (!item || !answer) return;

            const expanded = button.getAttribute("aria-expanded") === "true";
            button.setAttribute("aria-expanded", String(!expanded));
            item.classList.toggle("active", !expanded);
            answer.hidden = expanded;
        });
    });
</script>
