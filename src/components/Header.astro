---
import { Image } from "astro:assets";
import logo from "../assets/logo.webp";

const path = Astro.url.pathname;
const transactional = path === "/order" || path === "/thank-you" || path === "/order-confirmed";
const ctaHref = transactional ? "/" : "/order";
const ctaLabel = transactional ? "Home" : "Shop";

const links = [
    { href: "/beef-boxes", label: "Beef Boxes" },
    { href: "/our-story", label: "Our Story" },
    { href: "/delivery", label: "Delivery" },
    { href: "/faq", label: "FAQ" },
    { href: "/contact", label: "Contact" },
];
---

<header class="sticky top-0 z-50 border-b border-forest/10 bg-cream/95 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a href="/" class="flex min-w-0 items-center gap-3 text-forest no-underline" aria-label="Ferguson Livestock home">
            <Image
                src={logo}
                alt=""
                class="h-11 w-11 shrink-0 rounded-full object-cover"
                widths={[44, 88]}
                sizes="44px"
                loading="eager"
                decoding="async"
                fetchpriority="low"
            />
            <div class="min-w-0">
                <div class="font-display text-xl font-semibold leading-none tracking-tight sm:text-2xl">Ferguson Livestock</div>
                <div class="mt-1 hidden text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-sage sm:block">Snake Valley, Victoria</div>
            </div>
        </a>

        <nav class="hidden items-center gap-6 lg:flex" aria-label="Primary navigation">
            {links.map((link) => (
                <a
                    href={link.href}
                    class:list={[
                        "text-sm font-semibold no-underline transition-colors hover:text-sage",
                        path === link.href ? "text-sage" : "text-forest",
                    ]}
                    aria-current={path === link.href ? "page" : undefined}
                >{link.label}</a>
            ))}
        </nav>

        <div class="flex shrink-0 items-center gap-2">
            <a href={ctaHref} class="bg-forest px-4 py-2.5 text-sm font-semibold text-cream no-underline transition-colors hover:bg-sage sm:px-5">
                {ctaLabel}
            </a>
            <details class="group relative lg:hidden">
                <summary class="cursor-pointer list-none border border-forest/20 px-3 py-2.5 text-sm font-semibold text-forest marker:hidden">
                    Menu
                </summary>
                <nav class="absolute right-0 top-[calc(100%+0.75rem)] grid w-56 border border-forest/10 bg-cream p-2 shadow-xl" aria-label="Mobile navigation">
                    {links.map((link) => (
                        <a href={link.href} class="px-4 py-3 text-sm font-semibold text-forest no-underline hover:bg-cream-dark hover:text-sage">
                            {link.label}
                        </a>
                    ))}
                </nav>
            </details>
        </div>
    </div>
</header>
