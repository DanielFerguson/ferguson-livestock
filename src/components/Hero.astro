---
import { Image } from "astro:assets";
import heroImage from "../assets/images/cows-10.webp";
import { brandContent } from "../config/content";
import { bundles, formatAud, formatPerKg, products } from "../config/products";

const fiveKgBox = products["beef-box-5kg"];
const tenKgBox = bundles["beef-box-10kg"];
const startingPrice = Math.min(fiveKgBox.price, tenKgBox.displayPrice);
---

<main id="main-content">
    <section
        id="order"
        class="noise-overlay relative flex items-center overflow-hidden py-16 md:py-20 lg:py-24"
    >
        <div
            id="hero-bg"
            class="absolute inset-0 -z-20 will-change-transform"
            style="top: -10%; height: 120%;"
        >
            <Image
                src={heroImage}
                alt=""
                class="h-full w-full object-cover"
                widths={[800, 1200, 1600, 2000]}
                sizes="100vw"
                loading="eager"
            />
        </div>
        <div class="absolute inset-0 -z-10 bg-linear-to-br from-forest/95 via-forest-light/90 to-sage/85"></div>

        <div class="relative z-10 mx-auto w-full max-w-6xl px-6">
            <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
                <div class="text-cream">
                    <div class="animate-fade-in-up mb-6 inline-flex items-center gap-2 border border-mint/30 bg-mint/15 px-4 py-2 text-sm font-medium text-mint-light">
                        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                        </svg>
                        {brandContent.eyebrow}
                    </div>

                    <h1 class="animate-fade-in-up animation-delay-100 mb-6 max-w-3xl font-display text-5xl font-semibold leading-[0.98] tracking-tight sm:text-6xl lg:text-7xl">
                        Raised here.<br />
                        <em class="not-italic text-mint-light">Delivered by us.</em>
                    </h1>

                    <p class="animate-fade-in-up animation-delay-200 mb-8 max-w-2xl text-lg leading-relaxed text-cream/85 sm:text-xl">
                        {brandContent.heroDescription}
                    </p>

                    <div class="animate-fade-in-up animation-delay-300 flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium text-cream/90 sm:text-base">
                        <span class="flex items-center gap-2">
                            <svg class="h-5 w-5 fill-mint" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path></svg>
                            Pasture-raised
                        </span>
                        <span class="flex items-center gap-2">
                            <svg class="h-5 w-5 fill-mint" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path></svg>
                            Murray Grey
                        </span>
                        <span class="flex items-center gap-2">
                            <svg class="h-5 w-5 fill-mint" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path></svg>
                            Pickup or personal delivery
                        </span>
                    </div>
                </div>

                <aside class="animate-fade-in-up animation-delay-400 border border-cream/20 bg-cream/95 p-6 shadow-2xl shadow-black/20 backdrop-blur sm:p-8" aria-labelledby="hero-offer-title">
                    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-sage">Current availability</p>
                    <h2 id="hero-offer-title" class="mb-2 font-display text-3xl font-semibold text-forest sm:text-4xl">
                        Beef boxes from {formatAud(startingPrice)}
                    </h2>
                    <p id="hero-status-copy" class="mb-6 text-gray-600" aria-live="polite">
                        Check the current drop, or join the next one if boxes have sold out.
                    </p>

                    <div class="mb-6 divide-y divide-forest/10 border-y border-forest/10">
                        <div class="flex items-center justify-between gap-4 py-4">
                            <div>
                                <p class="font-semibold text-forest">{fiveKgBox.name}</p>
                                <p class="text-sm text-gray-500">{fiveKgBox.boxDetails!.bestFor}</p>
                            </div>
                            <div class="text-right">
                                <p class="font-bold text-forest">{formatAud(fiveKgBox.price)}</p>
                                <p class="text-xs text-sage">{formatPerKg(fiveKgBox.boxDetails!.perKgPrice)}</p>
                            </div>
                        </div>
                        <div class="flex items-center justify-between gap-4 py-4">
                            <div>
                                <p class="font-semibold text-forest">{tenKgBox.name}</p>
                                <p class="text-sm text-gray-500">{tenKgBox.boxDetails.bestFor}</p>
                            </div>
                            <div class="text-right">
                                <p class="font-bold text-forest">{formatAud(tenKgBox.displayPrice)}</p>
                                <p class="text-xs text-sage">{formatPerKg(tenKgBox.boxDetails.perKgPrice)}</p>
                            </div>
                        </div>
                    </div>

                    <div class="grid gap-3 sm:grid-cols-2">
                        <a
                            id="hero-primary-cta"
                            href="/order"
                            class="bg-forest px-6 py-3.5 text-center font-semibold text-cream transition-colors hover:bg-sage"
                        >View current availability</a>
                        <a
                            href="#about"
                            class="border border-forest/20 px-6 py-3.5 text-center font-semibold text-forest transition-colors hover:border-sage hover:text-sage"
                        >Meet Daniel &amp; Tahlia</a>
                    </div>
                </aside>
            </div>
        </div>
    </section>

    <script>
        const heroBg = document.getElementById("hero-bg");
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (heroBg && !prefersReducedMotion) {
            window.addEventListener(
                "scroll",
                () => {
                    heroBg.style.transform = `translateY(${window.scrollY * 0.25}px)`;
                },
                { passive: true },
            );
        }

        const statusCopy = document.getElementById("hero-status-copy");
        const primaryCta = document.getElementById("hero-primary-cta") as HTMLAnchorElement | null;
        const excludeFromExtras = new Set(["beef-box-5kg", "delivery-fee"]);

        function formatLaunchDate(epoch: number): string {
            return new Intl.DateTimeFormat("en-AU", {
                weekday: "long",
                day: "numeric",
                month: "long",
                hour: "numeric",
                hour12: true,
                timeZone: "Australia/Melbourne",
            }).format(new Date(epoch * 1000));
        }

        fetch("/api/stock")
            .then((response) => response.json())
            .then((data: { active: boolean; stock: Record<string, number>; launchAt: number | null }) => {
                if (!statusCopy || !primaryCta) return;

                const boxStock = data.stock["beef-box-5kg"] ?? 0;
                const hasExtrasStock = Object.entries(data.stock).some(
                    ([key, quantity]) => !excludeFromExtras.has(key) && quantity > 0,
                );

                if (data.active && boxStock > 0) {
                    statusCopy.textContent = "The current beef-box drop is open while stock lasts.";
                    primaryCta.textContent = "Shop this drop";
                    primaryCta.href = "/order";
                    return;
                }

                if (data.active && hasExtrasStock) {
                    statusCopy.textContent = "Beef boxes are sold out, but selected individual cuts are still available.";
                    primaryCta.textContent = "Shop available cuts";
                    primaryCta.href = "/order";
                    return;
                }

                statusCopy.textContent = data.launchAt && data.launchAt * 1000 > Date.now()
                    ? `The next drop opens ${formatLaunchDate(data.launchAt)}.`
                    : "The next beef-box drop is being prepared now.";
                primaryCta.textContent = "Join the next drop";
                primaryCta.href = "#waitlist";
            })
            .catch(() => {
                if (!statusCopy || !primaryCta) return;
                statusCopy.textContent = "Join the wait list and we’ll text you when the next drop opens.";
                primaryCta.textContent = "Join the next drop";
                primaryCta.href = "#waitlist";
            });
    </script>
</main>
