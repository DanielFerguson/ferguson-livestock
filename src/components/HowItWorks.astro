---

---

<section class="py-24 bg-cream">
    <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
            <span
                class="inline-block text-xs font-semibold uppercase tracking-widest text-sage mb-4"
                >The Process</span
            >
            <h2
                class="font-display text-3xl md:text-4xl lg:text-5xl font-semibold text-forest mb-4 tracking-tight"
            >
                From Our Paddock to Your Door
            </h2>
            <p class="text-lg text-gray-500 max-w-2xl mx-auto">
                A simple process that puts quality first at every step.
            </p>
        </div>
        <div class="relative">
            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                <div class="relative text-center">
                    <div
                        class="w-16 h-16 bg-linear-to-br from-forest to-sage rounded-full flex items-center justify-center mx-auto mb-6 relative z-10 shadow-lg shadow-forest/20"
                    >
                        <span
                            class="font-display text-2xl font-bold text-mint-light"
                            >1</span
                        >
                    </div>
                    <h3
                        class="font-display text-xl font-semibold text-forest mb-3"
                    >
                        Check the Current Drop
                    </h3>
                    <p class="text-gray-500 leading-relaxed">
                        See which boxes and individual cuts are available now.
                    </p>
                </div>
                <div class="relative text-center">
                    <div
                        class="w-16 h-16 bg-linear-to-br from-forest to-sage rounded-full flex items-center justify-center mx-auto mb-6 relative z-10 shadow-lg shadow-forest/20"
                    >
                        <span
                            class="font-display text-2xl font-bold text-mint-light"
                            >2</span
                        >
                    </div>
                    <h3
                        class="font-display text-xl font-semibold text-forest mb-3"
                    >
                        Choose What Suits You
                    </h3>
                    <p class="text-gray-500 leading-relaxed">
                        Pick a 5kg or 10kg box, then add any available extra cuts.
                    </p>
                </div>
                <div class="relative text-center">
                    <div
                        class="w-16 h-16 bg-linear-to-br from-forest to-sage rounded-full flex items-center justify-center mx-auto mb-6 relative z-10 shadow-lg shadow-forest/20"
                    >
                        <span
                            class="font-display text-2xl font-bold text-mint-light"
                            >3</span
                        >
                    </div>
                    <h3
                        class="font-display text-xl font-semibold text-forest mb-3"
                    >
                        Professionally Prepared
                    </h3>
                    <p class="text-gray-500 leading-relaxed">
                        A licensed local facility prepares and vacuum-seals each
                        cut before collection or delivery.
                    </p>
                </div>
                <div class="relative text-center">
                    <div
                        class="w-16 h-16 bg-linear-to-br from-forest to-sage rounded-full flex items-center justify-center mx-auto mb-6 relative z-10 shadow-lg shadow-forest/20"
                    >
                        <span
                            class="font-display text-2xl font-bold text-mint-light"
                            >4</span
                        >
                    </div>
                    <h3
                        class="font-display text-xl font-semibold text-forest mb-3"
                    >
                        Delivery or Pickup
                    </h3>
                    <p class="text-gray-500 leading-relaxed">
                        Choose personal delivery across the Ballarat region or
                        free farm pickup by arrangement in Snake Valley.
                    </p>
                </div>
            </div>
        </div>
        <div class="mt-16 text-center">
            <a
                href="/order"
                class="inline-flex items-center gap-2.5 bg-forest text-cream px-8 py-4 rounded-lg font-semibold transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-forest/20 no-underline"
                >View Current Availability<svg
                    class="w-5 h-5 fill-current"
                    viewBox="0 0 24 24"
                    ><path
                        d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"
                    ></path></svg
                ></a
            >
        </div>
    </div>
</section>
