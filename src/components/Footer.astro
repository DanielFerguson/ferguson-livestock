---
import { business } from "../config/business";
import { brandContent } from "../config/content";

const links = [
    { href: "/beef-boxes", label: "Beef Boxes" },
    { href: "/our-story", label: "Our Story" },
    { href: "/delivery", label: "Delivery & Pickup" },
    { href: "/faq", label: "FAQ" },
    { href: "/contact", label: "Contact" },
];

const policies = [
    { href: "/privacy", label: "Privacy" },
    { href: "/delivery-and-refunds", label: "Delivery & Refunds" },
];
---

<footer class="bg-forest py-14 text-cream">
    <div class="mx-auto max-w-6xl px-6">
        <div class="mb-12 grid gap-10 md:grid-cols-2 lg:grid-cols-[1.4fr_0.8fr_0.8fr_1.1fr]">
            <div>
                <div class="mb-4 font-display text-3xl font-semibold">{business.name}</div>
                <p class="max-w-sm text-sm leading-relaxed text-cream/75">{brandContent.promise}</p>
                <p class="mt-4 text-sm text-cream/60">{business.location.locality}, {business.location.region} · {business.location.proximity}</p>
            </div>

            <div>
                <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-mint-light">Explore</h2>
                <ul class="space-y-3">
                    {links.map((link) => (
                        <li><a href={link.href} class="text-sm text-cream/75 no-underline transition-colors hover:text-mint-light">{link.label}</a></li>
                    ))}
                </ul>
            </div>

            <div>
                <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-mint-light">Information</h2>
                <ul class="space-y-3">
                    {policies.map((link) => (
                        <li><a href={link.href} class="text-sm text-cream/75 no-underline transition-colors hover:text-mint-light">{link.label}</a></li>
                    ))}
                </ul>
            </div>

            <div>
                <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-mint-light">Talk to the farmers</h2>
                <div class="space-y-3 text-sm">
                    <a href={`tel:${business.phone.international}`} class="block text-cream/75 no-underline transition-colors hover:text-mint-light">{business.phone.display}</a>
                    <a href={`mailto:${business.email}`} class="block break-words text-cream/75 no-underline transition-colors hover:text-mint-light">{business.email}</a>
                    <a href={business.social.facebook} target="_blank" rel="noopener noreferrer" class="block text-cream/75 no-underline transition-colors hover:text-mint-light">Facebook</a>
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-3 border-t border-cream/10 pt-7 text-sm text-cream/50 sm:flex-row sm:items-center sm:justify-between">
            <p>&copy; {new Date().getFullYear()} {business.name}. All rights reserved.</p>
            <p>Raised in Snake Valley. Delivered by us.</p>
        </div>
    </div>
</footer>
