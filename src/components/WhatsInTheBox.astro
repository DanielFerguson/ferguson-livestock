---
import { Picture } from "astro:assets";
import boxImage from "../assets/images/box.webp";
import { bundles, formatAud, formatPerKg, products } from "../config/products";

const fiveKg = products["beef-box-5kg"];
const tenKg = bundles["beef-box-10kg"];
---

<section class="bg-forest py-16 text-cream lg:py-24">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 lg:grid-cols-2 lg:gap-20">
        <div>
            <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-mint-light">What’s in the box</p>
            <h2 class="mb-6 font-display text-4xl font-semibold leading-none sm:text-5xl lg:text-6xl">The cuts you look forward to—and the ones that keep weeknights moving.</h2>
            <p class="mb-8 max-w-xl text-lg leading-relaxed text-cream/75">Each box balances primary steaks with roast, slow-cook cuts, sausages and mince. The exact cuts vary naturally, but the total weight and value stay clear.</p>

            <div class="grid gap-px bg-cream/15 sm:grid-cols-2">
                {[{ product: fiveKg, price: fiveKg.price, details: fiveKg.boxDetails! }, { product: tenKg, price: tenKg.displayPrice, details: tenKg.boxDetails }].map(({ product, price, details }) => (
                    <div class="bg-forest-light p-6">
                        <p class="font-display text-3xl font-semibold">{product.name}</p>
                        <p class="mt-1 text-sm text-cream/65">{details.bestFor}</p>
                        <p class="mt-5 text-2xl font-bold text-mint-light">{formatAud(price)} <span class="text-sm font-medium text-cream/60">· {formatPerKg(details.perKgPrice)}</span></p>
                    </div>
                ))}
            </div>

            <a href="/beef-boxes" class="mt-8 inline-block bg-mint px-6 py-3.5 font-semibold text-forest no-underline hover:bg-mint-light">Compare the boxes</a>
        </div>

        <Picture
            src={boxImage}
            alt="Ferguson Livestock Murray Grey beef packed and ready for the freezer"
            class="aspect-square w-full object-cover"
            widths={[500, 720, 960]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            formats={["avif"]}
            fallbackFormat="webp"
            loading="lazy"
            decoding="async"
        />
    </div>
</section>
