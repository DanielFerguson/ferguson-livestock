---
import { Image } from "astro:assets";
import ctaImage from "../assets/images/8.webp";
---

<section class="noise-overlay relative py-24 text-center overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0 -z-20">
        <Image
            src={ctaImage}
            alt=""
            class="w-full h-full object-cover"
            widths={[800, 1200, 1600]}
            sizes="100vw"
        />
    </div>
    <!-- Warm Gradient Overlay -->
    <div
        class="absolute inset-0 -z-10 bg-linear-to-br from-warm/90 to-warm-dark/95"
    >
    </div>
    <div class="max-w-6xl mx-auto px-6 relative z-10">
        <h2
            class="font-display text-3xl md:text-4xl lg:text-5xl font-semibold text-white mb-4 tracking-tight"
        >
            Ready to Taste the Difference?
        </h2>
        <p class="text-lg text-white/90 mb-8 max-w-lg mx-auto">
            Orders are open for delivery February 13th and 14th. Choose your
            box size and checkout online. Limited boxes available.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a
                href="https://buy.stripe.com/9B65kE9NMeJN0FI0L12Nq01"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2.5 bg-white text-forest px-10 py-5 rounded-lg font-semibold text-base uppercase tracking-wider transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-black/20 no-underline"
                onclick="if(typeof gtag==='function'){gtag('event','begin_checkout',{currency:'AUD',value:150,items:[{item_name:'5kg Beef Box',price:150}]});}"
                >Order 5kg<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"
                    ><path
                        d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"
                    ></path></svg
                ></a
            >
            <a
                href="https://buy.stripe.com/00w4gA4ts9pt0FIctJ2Nq00"
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2.5 bg-forest text-cream px-10 py-5 rounded-lg font-semibold text-base uppercase tracking-wider transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-black/20 no-underline"
                onclick="if(typeof gtag==='function'){gtag('event','begin_checkout',{currency:'AUD',value:240,items:[{item_name:'10kg Beef Box',price:240}]});}"
                >Order 10kg<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"
                    ><path
                        d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"
                    ></path></svg
                ></a
            >
        </div>
        <p class="mt-6 text-white/70 text-sm">
            Not ready to order? <a href="#waitlist" class="text-white underline hover:text-mint-light transition-colors">Join the wait list</a> for future drops.
        </p>
    </div>
</section>
