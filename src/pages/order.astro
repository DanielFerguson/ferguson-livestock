---
import Layout from "../components/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import { business } from "../config/business";
import { bundles, formatAud, formatPerKg, products } from "../config/products";

export const prerender = false;

const pageTitle = "Order Your Beef Box | Ferguson Livestock";
const pageDescription = "Order premium pasture-raised Murray Grey beef boxes direct from our family farm. Choose your box size and add optional extras.";

const fiveKgBox = products["beef-box-5kg"];
const tenKgBox = bundles["beef-box-10kg"];
const delivery = products[business.delivery.feeProductId];
const extraProducts = Object.fromEntries(
    Object.entries(products).filter(([, product]) => product.type === "extra"),
);
const boxPrices = {
    "5kg": fiveKgBox.price,
    "10kg": tenKgBox.displayPrice,
};
const extraPrices = Object.fromEntries(
    Object.entries(extraProducts).map(([id, product]) => [id, product.price]),
);
const extraNames = Object.fromEntries(
    Object.entries(extraProducts).map(([id, product]) => [id, product.name]),
);
---

<Layout title={pageTitle} description={pageDescription} robots="noindex, follow">
    <Header />

    <main
        id="main-content"
        class="bg-cream-dark min-h-screen"
        data-box-prices={JSON.stringify(boxPrices)}
        data-extra-prices={JSON.stringify(extraPrices)}
        data-extra-names={JSON.stringify(extraNames)}
        data-delivery-fee={delivery.price}
    >
        <!-- Hero Banner -->
        <section class="bg-forest py-16 lg:py-20">
            <div class="max-w-4xl mx-auto px-6 text-center">
                <div id="hero-badge" class="inline-flex items-center gap-2 bg-mint/15 border border-mint/30 px-4 py-2 rounded-full text-sm font-medium text-mint-light mb-6">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
                    </svg>
                    Checking Current Availability
                </div>
                <h1 class="font-display text-4xl md:text-5xl font-semibold text-cream tracking-tight mb-4">Shop the Current Beef Drop</h1>
                <p class="text-lg text-cream/80 max-w-2xl mx-auto">Murray Grey beef from our Snake Valley farm, professionally packed and available for personal delivery or farm pickup.</p>
            </div>
        </section>

        <!-- Order Form -->
        <section class="py-12 lg:py-16">
            <div class="max-w-4xl mx-auto px-6">
                <!-- Loading State -->
                <div id="loading-state" class="text-center py-20">
                    <div class="inline-block w-8 h-8 border-4 border-sage/30 border-t-sage rounded-full animate-spin"></div>
                    <p class="text-gray-500 mt-4">Loading available products...</p>
                </div>

                <!-- Drop Inactive / All Sold Out -->
                <div id="inactive-state" class="hidden">
                    <div class="bg-white rounded-2xl shadow-xl border border-forest/5 p-8 md:p-12 text-center max-w-2xl mx-auto">
                        <div class="inline-flex items-center justify-center w-16 h-16 bg-warm/20 rounded-full mb-6">
                            <svg class="w-8 h-8 fill-warm" viewBox="0 0 24 24">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"></path>
                            </svg>
                        </div>
                        <h2 id="inactive-title" class="font-display text-2xl md:text-3xl font-semibold text-forest mb-3">All Sold Out!</h2>
                        <p id="inactive-subtitle" class="text-gray-500 mb-8 max-w-md mx-auto">This drop is completely sold out. Join the wait list below and we'll text you when the next batch is ready.</p>
                    </div>
                </div>

                <!-- Order Form (active state) -->
                <div id="order-form" class="hidden">
                    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="space-y-6">
                    <!-- Step 1: Choose Your Box -->
                    <div id="box-section" class="bg-white rounded-2xl shadow-xl border border-forest/5 p-6 md:p-8">
                        <div class="flex items-center gap-3 mb-6">
                            <span class="inline-flex items-center justify-center w-8 h-8 bg-forest text-cream text-sm font-bold rounded-full">1</span>
                            <h2 class="font-display text-2xl md:text-3xl font-semibold text-forest">Choose Your Box</h2>
                        </div>

                        <div class="grid md:grid-cols-2 gap-4" id="box-options">
                            <!-- 5kg Box -->
                            <button
                                type="button"
                                data-box="5kg"
                                class="box-option group relative bg-cream rounded-xl p-6 border-2 border-transparent transition-all duration-200 hover:border-sage hover:shadow-md text-left cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:border-transparent disabled:hover:shadow-none"
                            >
                                <div class="flex items-baseline justify-between gap-2 mb-1">
                                    <div class="flex items-baseline gap-2">
                                        <h3 class="font-display text-xl font-semibold text-forest">{fiveKgBox.name}</h3>
                                        <span class="text-sm text-sage font-medium">{formatPerKg(fiveKgBox.boxDetails!.perKgPrice)}</span>
                                    </div>
                                    <span class="box-stock text-sm font-semibold text-sage" data-product="beef-box-5kg"></span>
                                </div>
                                <p class="text-2xl font-bold text-forest">{formatAud(fiveKgBox.price)}</p>
                                <p class="text-sm text-gray-500 mt-2">
                                    {fiveKgBox.description}
                                </p>
                                <div class="box-check absolute top-3 right-3 w-6 h-6 bg-sage rounded-full flex items-center justify-center opacity-0 transition-opacity duration-200">
                                    <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24">
                                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path>
                                    </svg>
                                </div>
                                <div class="box-sold-out hidden absolute inset-0 bg-cream/80 rounded-xl flex items-center justify-center">
                                    <span class="px-4 py-2 bg-cream-dark text-forest text-xs font-semibold uppercase tracking-wider rounded-full">Sold Out</span>
                                </div>
                            </button>

                            <!-- 10kg Box -->
                            <button
                                type="button"
                                data-box="10kg"
                                class="box-option group relative bg-cream rounded-xl p-6 border-2 border-transparent transition-all duration-200 hover:border-warm hover:shadow-md text-left cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:border-transparent disabled:hover:shadow-none"
                            >
                                <div class="absolute -top-3 left-5 bg-warm text-white text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">Best Value</div>
                                <div class="flex items-baseline justify-between gap-2 mb-1 mt-1">
                                    <div class="flex items-baseline gap-2">
                                        <h3 class="font-display text-xl font-semibold text-forest">{tenKgBox.name}</h3>
                                        <span class="text-sm text-warm-dark font-medium">{formatPerKg(tenKgBox.boxDetails.perKgPrice)}</span>
                                    </div>
                                    <span class="box-stock text-sm font-semibold text-warm-dark" data-product="beef-box-5kg" data-requires="2"></span>
                                </div>
                                <p class="text-2xl font-bold text-forest">{formatAud(tenKgBox.displayPrice)}</p>
                                <p class="text-sm text-gray-500 mt-2">
                                    {tenKgBox.description}
                                </p>
                                <div class="box-check absolute top-3 right-3 w-6 h-6 bg-warm rounded-full flex items-center justify-center opacity-0 transition-opacity duration-200">
                                    <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24">
                                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path>
                                    </svg>
                                </div>
                                <div class="box-sold-out hidden absolute inset-0 bg-cream/80 rounded-xl flex items-center justify-center">
                                    <span class="px-4 py-2 bg-cream-dark text-forest text-xs font-semibold uppercase tracking-wider rounded-full">Sold Out</span>
                                </div>
                            </button>
                        </div>
                        <div id="box-sold-notice" class="hidden text-center py-4">
                            <p class="text-sm font-semibold text-warm-dark uppercase tracking-wider mb-1">Beef Boxes — Sold Out</p>
                            <p class="text-sm text-gray-500">Browse our additional cuts below to place an order.</p>
                        </div>
                    </div>

                    <!-- Step 2: Additional Cuts -->
                    <div id="extras-section" class="bg-white rounded-2xl shadow-xl border border-forest/5 p-6 md:p-8 opacity-50 pointer-events-none transition-opacity duration-300">
                        <div class="flex items-center gap-3 mb-2">
                            <span class="inline-flex items-center justify-center w-8 h-8 bg-forest text-cream text-sm font-bold rounded-full">2</span>
                            <h2 class="font-display text-2xl md:text-3xl font-semibold text-forest">Additional Cuts</h2>
                        </div>
                        <p class="text-sm text-gray-500 mb-6 ml-11">Add premium cuts to your order while stocks last.</p>

                        <div class="space-y-4" id="extras-list">
                            <!-- 500g Beef Mince -->
                            <div class="extra-item flex flex-col items-stretch justify-between gap-4 bg-cream rounded-xl p-5 sm:flex-row sm:items-center" data-product="beef-mince-500g" data-price={products["beef-mince-500g"].price}>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-baseline gap-2 flex-wrap">
                                        <h3 class="font-semibold text-forest">{products["beef-mince-500g"].name}</h3>
                                        <span class="text-sm font-bold text-forest">{formatAud(products["beef-mince-500g"].price)}</span>
                                    </div>
                                    <p class="text-sm text-gray-500">{products["beef-mince-500g"].description}</p>
                                    <span class="extra-stock text-xs font-medium text-sage mt-1 inline-block"></span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button
                                        type="button"
                                        class="qty-btn qty-minus w-9 h-9 rounded-full bg-white border border-forest/20 text-forest flex items-center justify-center font-bold text-lg transition-colors hover:bg-forest hover:text-cream disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-forest cursor-pointer"
                                        disabled
                                    >
                                        &minus;
                                    </button>
                                    <span class="qty-display w-8 text-center font-bold text-forest">0</span>
                                    <button
                                        type="button"
                                        class="qty-btn qty-plus w-9 h-9 rounded-full bg-white border border-forest/20 text-forest flex items-center justify-center font-bold text-lg transition-colors hover:bg-forest hover:text-cream disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-forest cursor-pointer"
                                    >
                                        +
                                    </button>
                                </div>
                            </div>

                            <!-- 2kg Beef Bones -->
                            <div class="extra-item flex flex-col items-stretch justify-between gap-4 bg-cream rounded-xl p-5 sm:flex-row sm:items-center" data-product="beef-bones-2kg" data-price={products["beef-bones-2kg"].price}>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-baseline gap-2 flex-wrap">
                                        <h3 class="font-semibold text-forest">{products["beef-bones-2kg"].name}</h3>
                                        <span class="text-sm font-bold text-forest">{formatAud(products["beef-bones-2kg"].price)}</span>
                                    </div>
                                    <p class="text-sm text-gray-500">{products["beef-bones-2kg"].description}</p>
                                    <span class="extra-stock text-xs font-medium text-sage mt-1 inline-block"></span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button
                                        type="button"
                                        class="qty-btn qty-minus w-9 h-9 rounded-full bg-white border border-forest/20 text-forest flex items-center justify-center font-bold text-lg transition-colors hover:bg-forest hover:text-cream disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-forest cursor-pointer"
                                        disabled
                                    >
                                        &minus;
                                    </button>
                                    <span class="qty-display w-8 text-center font-bold text-forest">0</span>
                                    <button
                                        type="button"
                                        class="qty-btn qty-plus w-9 h-9 rounded-full bg-white border border-forest/20 text-forest flex items-center justify-center font-bold text-lg transition-colors hover:bg-forest hover:text-cream disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-forest cursor-pointer"
                                    >
                                        +
                                    </button>
                                </div>
                            </div>

                            <!-- Sausage Packs (6) -->
                            <div class="extra-item flex flex-col items-stretch justify-between gap-4 bg-cream rounded-xl p-5 sm:flex-row sm:items-center" data-product="sausage-packs-6" data-price={products["sausage-packs-6"].price}>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-baseline gap-2 flex-wrap">
                                        <h3 class="font-semibold text-forest">{products["sausage-packs-6"].name}</h3>
                                        <span class="text-sm font-bold text-forest">{formatAud(products["sausage-packs-6"].price)}</span>
                                    </div>
                                    <p class="text-sm text-gray-500">{products["sausage-packs-6"].description}</p>
                                    <span class="extra-stock text-xs font-medium text-sage mt-1 inline-block"></span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button
                                        type="button"
                                        class="qty-btn qty-minus w-9 h-9 rounded-full bg-white border border-forest/20 text-forest flex items-center justify-center font-bold text-lg transition-colors hover:bg-forest hover:text-cream disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-forest cursor-pointer"
                                        disabled
                                    >
                                        &minus;
                                    </button>
                                    <span class="qty-display w-8 text-center font-bold text-forest">0</span>
                                    <button
                                        type="button"
                                        class="qty-btn qty-plus w-9 h-9 rounded-full bg-white border border-forest/20 text-forest flex items-center justify-center font-bold text-lg transition-colors hover:bg-forest hover:text-cream disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-forest cursor-pointer"
                                    >
                                        +
                                    </button>
                                </div>
                            </div>

                            <!-- Rump Steak (2) -->
                            <div class="extra-item flex flex-col items-stretch justify-between gap-4 bg-cream rounded-xl p-5 sm:flex-row sm:items-center" data-product="rump-steak-2" data-price={products["rump-steak-2"].price}>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-baseline gap-2 flex-wrap">
                                        <h3 class="font-semibold text-forest">{products["rump-steak-2"].name}</h3>
                                        <span class="text-sm font-bold text-forest">{formatAud(products["rump-steak-2"].price)}</span>
                                    </div>
                                    <p class="text-sm text-gray-500">{products["rump-steak-2"].description}</p>
                                    <span class="extra-stock text-xs font-medium text-sage mt-1 inline-block"></span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button
                                        type="button"
                                        class="qty-btn qty-minus w-9 h-9 rounded-full bg-white border border-forest/20 text-forest flex items-center justify-center font-bold text-lg transition-colors hover:bg-forest hover:text-cream disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-forest cursor-pointer"
                                        disabled
                                    >
                                        &minus;
                                    </button>
                                    <span class="qty-display w-8 text-center font-bold text-forest">0</span>
                                    <button
                                        type="button"
                                        class="qty-btn qty-plus w-9 h-9 rounded-full bg-white border border-forest/20 text-forest flex items-center justify-center font-bold text-lg transition-colors hover:bg-forest hover:text-cream disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-forest cursor-pointer"
                                    >
                                        +
                                    </button>
                                </div>
                            </div>

                            <!-- Porterhouse -->
                            <div class="extra-item flex flex-col items-stretch justify-between gap-4 bg-cream rounded-xl p-5 sm:flex-row sm:items-center" data-product="porterhouse" data-price={products.porterhouse.price}>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-baseline gap-2 flex-wrap">
                                        <h3 class="font-semibold text-forest">{products.porterhouse.name}</h3>
                                        <span class="text-sm font-bold text-forest">{formatAud(products.porterhouse.price)}</span>
                                    </div>
                                    <p class="text-sm text-gray-500">{products.porterhouse.description}</p>
                                    <span class="extra-stock text-xs font-medium text-sage mt-1 inline-block"></span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button
                                        type="button"
                                        class="qty-btn qty-minus w-9 h-9 rounded-full bg-white border border-forest/20 text-forest flex items-center justify-center font-bold text-lg transition-colors hover:bg-forest hover:text-cream disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-forest cursor-pointer"
                                        disabled
                                    >
                                        &minus;
                                    </button>
                                    <span class="qty-display w-8 text-center font-bold text-forest">0</span>
                                    <button
                                        type="button"
                                        class="qty-btn qty-plus w-9 h-9 rounded-full bg-white border border-forest/20 text-forest flex items-center justify-center font-bold text-lg transition-colors hover:bg-forest hover:text-cream disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-forest cursor-pointer"
                                    >
                                        +
                                    </button>
                                </div>
                            </div>

                            <!-- Diced Chuck -->
                            <div class="extra-item flex flex-col items-stretch justify-between gap-4 bg-cream rounded-xl p-5 sm:flex-row sm:items-center" data-product="diced-chuck" data-price={products["diced-chuck"].price}>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-baseline gap-2 flex-wrap">
                                        <h3 class="font-semibold text-forest">{products["diced-chuck"].name}</h3>
                                        <span class="text-sm font-bold text-forest">{formatAud(products["diced-chuck"].price)}</span>
                                    </div>
                                    <p class="text-sm text-gray-500">{products["diced-chuck"].description}</p>
                                    <span class="extra-stock text-xs font-medium text-sage mt-1 inline-block"></span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <button
                                        type="button"
                                        class="qty-btn qty-minus w-9 h-9 rounded-full bg-white border border-forest/20 text-forest flex items-center justify-center font-bold text-lg transition-colors hover:bg-forest hover:text-cream disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-forest cursor-pointer"
                                        disabled
                                    >
                                        &minus;
                                    </button>
                                    <span class="qty-display w-8 text-center font-bold text-forest">0</span>
                                    <button
                                        type="button"
                                        class="qty-btn qty-plus w-9 h-9 rounded-full bg-white border border-forest/20 text-forest flex items-center justify-center font-bold text-lg transition-colors hover:bg-forest hover:text-cream disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-forest cursor-pointer"
                                    >
                                        +
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Delivery Method -->
                    <div
                      id="delivery-section"
                      class="bg-white rounded-2xl shadow-xl border border-forest/5 p-6 md:p-8 opacity-50 pointer-events-none transition-opacity duration-300"
                    >
                        <div class="flex items-center gap-3 mb-2">
                            <span class="inline-flex items-center justify-center w-8 h-8 bg-forest text-cream text-sm font-bold rounded-full">3</span>
                            <h2 class="font-display text-2xl md:text-3xl font-semibold text-forest">Delivery Method</h2>
                        </div>
                        <p class="text-sm text-gray-500 mb-6 ml-11">How would you like to receive your order?</p>

                        <div class="grid md:grid-cols-2 gap-4 items-stretch" id="delivery-options">
                            <button
                              type="button"
                              data-delivery="delivery"
                              class="delivery-option relative w-full text-left bg-cream rounded-xl p-5 border-2 border-transparent transition-all duration-200 hover:border-sage hover:shadow-md cursor-pointer flex flex-col justify-start"
                            >
                                <div class="delivery-check absolute top-3 right-3 w-6 h-6 bg-sage rounded-full flex items-center justify-center opacity-0 transition-opacity duration-200">
                                    <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24">
                                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path>
                                    </svg>
                                </div>
                                <div class="flex items-baseline gap-2">
                                    <h3 class="font-semibold text-forest">{delivery.name}</h3>
                                    <span class="text-sm font-bold text-forest">{formatAud(delivery.price)}</span>
                                </div>
                                <p class="text-sm text-gray-500 mt-1">{delivery.description}</p>
                            </button>

                            <button
                              type="button"
                              data-delivery="pickup"
                              class="delivery-option relative w-full text-left bg-cream rounded-xl p-5 border-2 border-transparent transition-all duration-200 hover:border-sage hover:shadow-md cursor-pointer flex flex-col justify-start"
                            >
                                <div class="delivery-check absolute top-3 right-3 w-6 h-6 bg-sage rounded-full flex items-center justify-center opacity-0 transition-opacity duration-200">
                                    <svg class="w-4 h-4 fill-white" viewBox="0 0 24 24">
                                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path>
                                    </svg>
                                </div>
                                <div class="flex items-baseline gap-2">
                                    <h3 class="font-semibold text-forest">{business.pickup.label}</h3>
                                    <span class="text-sm font-bold text-sage">Free</span>
                                </div>
                                <p class="text-sm text-gray-500 mt-1">{business.pickup.description}</p>
                            </button>
                        </div>
                    </div>

                        </div>

                        <aside class="space-y-5 lg:sticky lg:top-28">
                    <!-- Order Summary & Checkout -->
                    <div id="summary-section" class="bg-white rounded-sm border border-forest/10 p-6 opacity-50 pointer-events-none transition-opacity duration-300 lg:p-7">
                        <div class="flex items-center gap-3 mb-6">
                            <span class="inline-flex items-center justify-center w-8 h-8 bg-forest text-cream text-sm font-bold rounded-full">4</span>
                            <h2 class="font-display text-2xl font-semibold text-forest">Your order</h2>
                        </div>

                        <div id="summary-items" class="space-y-3 mb-6">
                            <p class="text-gray-400 italic" id="summary-placeholder">Select a box to get started</p>
                        </div>

                        <div class="border-t border-forest/10 pt-4 mb-6 flex items-center justify-between">
                            <span class="font-display text-xl font-semibold text-forest">Total</span>
                            <span id="summary-total" class="font-display text-2xl font-bold text-forest">$0</span>
                        </div>

                        <div class="space-y-3">
                            <button
                                type="button"
                                id="checkout-btn"
                                disabled
                                class="w-full bg-forest text-cream py-4 px-8 rounded-lg font-semibold text-lg transition-all duration-300 hover:bg-sage hover:-translate-y-0.5 hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0 disabled:hover:shadow-none cursor-pointer"
                            >
                                Proceed to Checkout
                            </button>
                            <p class="text-center text-xs text-gray-500">Delivery details and secure payment are completed on the next page.</p>
                        </div>

                        <!-- Error Message -->
                        <div id="checkout-error" class="hidden mt-4 bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-700"></div>
                    </div>

                    <!-- Trust Signals -->
                    <div class="grid gap-3 border border-forest/10 bg-cream/70 p-5 text-sm text-gray-500">
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"></path>
                            </svg>
                            Secure checkout via Stripe
                        </div>
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                                <path
                                    d="M18 18.5c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5-1.5.67-1.5 1.5.67 1.5 1.5 1.5zM19.96 10H18V6H6v2h9.5L12 13.5H5V15h5.8l.3.5H18v-2h.54l3.04-4.5L19.96 10zM6 18.5c.83 0 1.5-.67 1.5-1.5s-.67-1.5-1.5-1.5-1.5.67-1.5 1.5.67 1.5 1.5 1.5z"
                                ></path>
                            </svg>
                            Personal delivery or farm pickup
                        </div>
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"></path>
                            </svg>
                            Pasture-raised Murray Grey beef
                        </div>
                    </div>
                        </aside>
                    </div>
                </div>
            </div>
        </section>

        <!-- Waitlist Fallback (shown when sold out) -->
        <div id="waitlist-fallback" class="hidden">
            <WaitlistForm />
        </div>
    </main>

    <Footer />

    <script>
        interface StockData {
            active: boolean;
            stock: Record<string, number>;
            launchAt: number | null;
        }

        interface ExtraSelection {
            productId: string;
            quantity: number;
        }

        // State
        let stockData: StockData | null = null;
        let selectedBox: "5kg" | "10kg" | null = null;
        let deliveryMethod: "delivery" | "pickup" | null = null;
        const extras: Map<string, number> = new Map();
        let extrasOnlyMode = false;

        // DOM refs
        const loadingState = document.getElementById("loading-state")!;
        const inactiveState = document.getElementById("inactive-state")!;
        const orderForm = document.getElementById("order-form")!;
        const extrasSection = document.getElementById("extras-section")!;
        const deliverySection = document.getElementById("delivery-section")!;
        const summarySection = document.getElementById("summary-section")!;
        const summaryItems = document.getElementById("summary-items")!;
        const summaryPlaceholder = document.getElementById("summary-placeholder")!;
        const summaryTotal = document.getElementById("summary-total")!;
        const checkoutBtn = document.getElementById("checkout-btn") as HTMLButtonElement;
        const checkoutError = document.getElementById("checkout-error")!;
        const waitlistFallback = document.getElementById("waitlist-fallback")!;
        const boxSection = document.getElementById("box-section")!;
        const heroBadge = document.getElementById("hero-badge")!;
        const orderPage = document.getElementById("main-content") as HTMLElement;

        // Commercial values are rendered from the shared catalogue configuration.
        const BOX_PRICES = JSON.parse(orderPage.dataset.boxPrices ?? "{}") as Record<string, number>;
        const EXTRA_PRICES = JSON.parse(orderPage.dataset.extraPrices ?? "{}") as Record<string, number>;
        const EXTRA_NAMES = JSON.parse(orderPage.dataset.extraNames ?? "{}") as Record<string, string>;
        const DELIVERY_FEE = Number(orderPage.dataset.deliveryFee ?? 0);

        const EXTRA_PRODUCT_IDS = Object.keys(EXTRA_PRICES);

        function hasAnyExtrasInStock(): boolean {
            if (!stockData) return false;
            return EXTRA_PRODUCT_IDS.some((id) => (stockData!.stock[id] ?? 0) > 0);
        }

        function formatLaunchDate(epoch: number): string {
            return new Intl.DateTimeFormat("en-AU", {
                weekday: "long",
                day: "numeric",
                month: "long",
                hour: "numeric",
                hour12: true,
                timeZone: "Australia/Melbourne",
            }).format(new Date(epoch * 1000));
        }

        function showInactiveState(): void {
            inactiveState.classList.remove("hidden");
            waitlistFallback.classList.remove("hidden");

            // Show launch date if scheduled
            if (stockData?.launchAt && stockData.launchAt * 1000 > Date.now()) {
                const title = document.getElementById("inactive-title");
                const subtitle = document.getElementById("inactive-subtitle");
                if (title) title.textContent = "Launching Soon!";
                if (subtitle) subtitle.textContent = `Orders open ${formatLaunchDate(stockData.launchAt)}. Join the wait list below to get notified.`;
            }
        }

        async function fetchStock(): Promise<void> {
            try {
                const res = await fetch("/api/stock");
                if (!res.ok) throw new Error("Failed to fetch stock");
                stockData = await res.json();

                loadingState.classList.add("hidden");

                if (!stockData!.active) {
                    showInactiveState();
                    return;
                }

                const boxStock = stockData!.stock["beef-box-5kg"] ?? 0;
                if (boxStock <= 0) {
                    if (hasAnyExtrasInStock()) {
                        // Extras-only mode
                        extrasOnlyMode = true;
                        document.getElementById("box-options")!.classList.add("hidden");
                        boxSection.querySelector(".flex.items-center.gap-3")!.classList.add("hidden");
                        document.getElementById("box-sold-notice")!.classList.remove("hidden");
                        heroBadge.textContent = "Beef Boxes Sold Out — Extras Still Available";
                        // Update step numbers
                        extrasSection.querySelector(".bg-forest.text-cream.text-sm")!.textContent = "1";
                        deliverySection.querySelector(".bg-forest.text-cream.text-sm")!.textContent = "2";
                        summarySection.querySelector(".bg-forest.text-cream.text-sm")!.textContent = "3";
                        // Change extras subtitle since there's no box
                        const extrasSubtitle = extrasSection.querySelector("p.text-sm.text-gray-500");
                        if (extrasSubtitle) extrasSubtitle.textContent = "Select from our range of premium cuts.";
                        // Change summary placeholder
                        summaryPlaceholder.textContent = "Select extras to get started";
                        orderForm.classList.remove("hidden");
                        updateStockDisplay();
                    } else {
                        showInactiveState();
                    }
                    return;
                }

                orderForm.classList.remove("hidden");
                updateStockDisplay();
            } catch {
                loadingState.textContent = "Failed to load products. Please refresh the page.";
            }
        }

        function updateStockDisplay(): void {
            if (!stockData) return;

            document.querySelectorAll<HTMLElement>(".box-option").forEach((btn) => {
                const box = btn.dataset.box as string;
                const stockEl = btn.querySelector<HTMLElement>(".box-stock")!;
                const soldOutEl = btn.querySelector<HTMLElement>(".box-sold-out")!;
                const productId = stockEl.dataset.product!;
                const requires = parseInt(stockEl.dataset.requires || "1", 10);
                const available = stockData!.stock[productId] ?? 0;
                const canOrder = available >= requires;

                if (canOrder) {
                    const availableUnits = Math.floor(available / requires);
                    stockEl.textContent = `${availableUnits} left`;
                    soldOutEl.classList.add("hidden");
                    (btn as HTMLButtonElement).disabled = false;
                } else {
                    stockEl.textContent = "";
                    soldOutEl.classList.remove("hidden");
                    (btn as HTMLButtonElement).disabled = true;
                    if (selectedBox === box) {
                        selectedBox = null;
                        btn.classList.remove("border-sage", "border-warm", "shadow-md");
                        const check = btn.querySelector<HTMLElement>(".box-check");
                        if (check) {
                            check.classList.remove("opacity-100");
                            check.classList.add("opacity-0");
                        }
                    }
                }
            });

            document.querySelectorAll<HTMLElement>(".extra-item").forEach((item) => {
                const productId = item.dataset.product!;
                const available = stockData!.stock[productId] ?? 0;
                const stockEl = item.querySelector<HTMLElement>(".extra-stock")!;
                const plusBtn = item.querySelector<HTMLButtonElement>(".qty-plus")!;

                if (available <= 0) {
                    stockEl.textContent = "Sold out";
                    stockEl.classList.remove("text-sage");
                    stockEl.classList.add("text-warm-dark");
                    plusBtn.disabled = true;
                } else {
                    stockEl.textContent = `${available} left`;
                    stockEl.classList.add("text-sage");
                    stockEl.classList.remove("text-warm-dark");
                    const currentQty = extras.get(productId) || 0;
                    plusBtn.disabled = currentQty >= available;
                }
            });

            const boxStock = stockData!.stock["beef-box-5kg"] ?? 0;
            if (boxStock <= 0 && !extrasOnlyMode) {
                if (hasAnyExtrasInStock()) {
                    // Switch to extras-only mode dynamically (e.g., after 409 stock update)
                    extrasOnlyMode = true;
                    document.getElementById("box-options")!.classList.add("hidden");
                    boxSection.querySelector(".flex.items-center.gap-3")!.classList.add("hidden");
                    document.getElementById("box-sold-notice")!.classList.remove("hidden");
                    selectedBox = null;
                    heroBadge.textContent = "Beef Boxes Sold Out — Extras Still Available";
                    extrasSection.querySelector(".bg-forest.text-cream.text-sm")!.textContent = "1";
                    deliverySection.querySelector(".bg-forest.text-cream.text-sm")!.textContent = "2";
                    summarySection.querySelector(".bg-forest.text-cream.text-sm")!.textContent = "3";
                    const extrasSubtitle = extrasSection.querySelector("p.text-sm.text-gray-500");
                    if (extrasSubtitle) extrasSubtitle.textContent = "Select from our range of premium cuts.";
                    summaryPlaceholder.textContent = "Select extras to get started";
                } else {
                    orderForm.classList.add("hidden");
                    inactiveState.classList.remove("hidden");
                    waitlistFallback.classList.remove("hidden");
                }
            } else if (extrasOnlyMode && !hasAnyExtrasInStock()) {
                // All extras now sold out too
                orderForm.classList.add("hidden");
                inactiveState.classList.remove("hidden");
                waitlistFallback.classList.remove("hidden");
            }

            updateSectionStates();
        }

        function updateSectionStates(): void {
            if (extrasOnlyMode) {
                // Extras always enabled; delivery/summary enabled when any extra selected
                const hasExtras = extras.size > 0;
                extrasSection.classList.remove("opacity-50", "pointer-events-none");
                deliverySection.classList.toggle("opacity-50", !hasExtras);
                deliverySection.classList.toggle("pointer-events-none", !hasExtras);
                summarySection.classList.toggle("opacity-50", !hasExtras);
                summarySection.classList.toggle("pointer-events-none", !hasExtras);
            } else {
                const hasBox = selectedBox !== null;
                extrasSection.classList.toggle("opacity-50", !hasBox);
                extrasSection.classList.toggle("pointer-events-none", !hasBox);
                deliverySection.classList.toggle("opacity-50", !hasBox);
                deliverySection.classList.toggle("pointer-events-none", !hasBox);
                summarySection.classList.toggle("opacity-50", !hasBox);
                summarySection.classList.toggle("pointer-events-none", !hasBox);
            }
        }

        function updateSummary(): void {
            // Clear existing line items (but not the placeholder)
            const existingLines = summaryItems.querySelectorAll(".summary-line");
            existingLines.forEach((el) => el.remove());

            let total = 0;
            let hasItems = false;

            if (selectedBox) {
                hasItems = true;
                const price = BOX_PRICES[selectedBox];
                total += price;
                const line = document.createElement("div");
                line.className = "summary-line flex justify-between items-center";
                const label = document.createElement("span");
                label.className = "text-forest";
                label.textContent = `${selectedBox} Beef Box`;
                const value = document.createElement("span");
                value.className = "font-semibold text-forest";
                value.textContent = `$${(price / 100).toFixed(0)}`;
                line.appendChild(label);
                line.appendChild(value);
                summaryItems.appendChild(line);
            }

            extras.forEach((qty, productId) => {
                if (qty > 0) {
                    hasItems = true;
                    const price = EXTRA_PRICES[productId] * qty;
                    total += price;
                    const line = document.createElement("div");
                    line.className = "summary-line flex justify-between items-center";
                    const label = document.createElement("span");
                    label.className = "text-forest";
                    label.textContent = `${EXTRA_NAMES[productId]} x${qty}`;
                    const value = document.createElement("span");
                    value.className = "font-semibold text-forest";
                    value.textContent = `$${(price / 100).toFixed(0)}`;
                    line.appendChild(label);
                    line.appendChild(value);
                    summaryItems.appendChild(line);
                }
            });

            if (deliveryMethod) {
                hasItems = true;
                if (deliveryMethod === "delivery") {
                    total += DELIVERY_FEE;
                    const line = document.createElement("div");
                    line.className = "summary-line flex justify-between items-center";
                    const label = document.createElement("span");
                    label.className = "text-forest";
                    label.textContent = "Delivery";
                    const value = document.createElement("span");
                    value.className = "font-semibold text-forest";
                    value.textContent = `$${(DELIVERY_FEE / 100).toFixed(0)}`;
                    line.appendChild(label);
                    line.appendChild(value);
                    summaryItems.appendChild(line);
                } else {
                    const line = document.createElement("div");
                    line.className = "summary-line flex justify-between items-center";
                    const label = document.createElement("span");
                    label.className = "text-forest";
                    label.textContent = "Farm Pickup";
                    const value = document.createElement("span");
                    value.className = "font-semibold text-sage";
                    value.textContent = "Free";
                    line.appendChild(label);
                    line.appendChild(value);
                    summaryItems.appendChild(line);
                }
            }

            summaryPlaceholder.classList.toggle("hidden", hasItems);
            summaryTotal.textContent = `$${(total / 100).toFixed(0)}`;
            if (extrasOnlyMode) {
                checkoutBtn.disabled = extras.size === 0 || !deliveryMethod;
            } else {
                checkoutBtn.disabled = !selectedBox || !deliveryMethod;
            }
        }

        // Box selection
        document.querySelectorAll<HTMLElement>(".box-option").forEach((btn) => {
            btn.addEventListener("click", () => {
                if ((btn as HTMLButtonElement).disabled) return;
                const box = btn.dataset.box as "5kg" | "10kg";
                selectedBox = selectedBox === box ? null : box;

                document.querySelectorAll<HTMLElement>(".box-option").forEach((b) => {
                    const isSelected = b.dataset.box === selectedBox;
                    const borderColor = b.dataset.box === "10kg" ? "border-warm" : "border-sage";
                    b.classList.toggle(borderColor, isSelected);
                    b.classList.toggle("shadow-md", isSelected);
                    const check = b.querySelector<HTMLElement>(".box-check");
                    if (check) {
                        check.classList.toggle("opacity-0", !isSelected);
                        check.classList.toggle("opacity-100", isSelected);
                    }
                });

                updateSectionStates();
                updateSummary();
            });
        });

        // Extras quantity buttons
        document.querySelectorAll<HTMLElement>(".extra-item").forEach((item) => {
            const productId = item.dataset.product!;
            const minusBtn = item.querySelector<HTMLButtonElement>(".qty-minus")!;
            const plusBtn = item.querySelector<HTMLButtonElement>(".qty-plus")!;
            const display = item.querySelector<HTMLElement>(".qty-display")!;

            minusBtn.addEventListener("click", () => {
                const current = extras.get(productId) || 0;
                if (current > 0) {
                    const newQty = current - 1;
                    if (newQty === 0) extras.delete(productId);
                    else extras.set(productId, newQty);
                    display.textContent = String(newQty);
                    minusBtn.disabled = newQty <= 0;
                    const available = stockData?.stock[productId] ?? 0;
                    plusBtn.disabled = newQty >= available;
                }
                updateSectionStates();
                updateSummary();
            });

            plusBtn.addEventListener("click", () => {
                const current = extras.get(productId) || 0;
                const available = stockData?.stock[productId] ?? 0;
                if (current < available) {
                    const newQty = current + 1;
                    extras.set(productId, newQty);
                    display.textContent = String(newQty);
                    minusBtn.disabled = false;
                    plusBtn.disabled = newQty >= available;
                }
                updateSectionStates();
                updateSummary();
            });
        });

        // Delivery method selection
        document.querySelectorAll<HTMLElement>(".delivery-option").forEach((btn) => {
            btn.addEventListener("click", () => {
                const method = btn.dataset.delivery as "delivery" | "pickup";
                deliveryMethod = deliveryMethod === method ? null : method;

                document.querySelectorAll<HTMLElement>(".delivery-option").forEach((b) => {
                    const isSelected = b.dataset.delivery === deliveryMethod;
                    b.classList.toggle("border-sage", isSelected);
                    b.classList.toggle("shadow-md", isSelected);
                    const check = b.querySelector<HTMLElement>(".delivery-check");
                    if (check) {
                        check.classList.toggle("opacity-0", !isSelected);
                        check.classList.toggle("opacity-100", isSelected);
                    }
                });

                updateSummary();
            });
        });

        // Checkout
        checkoutBtn.addEventListener("click", async () => {
            if (extrasOnlyMode) {
                if (extras.size === 0 || !deliveryMethod) return;
            } else {
                if (!selectedBox || !deliveryMethod) return;
            }

            checkoutBtn.disabled = true;
            checkoutBtn.textContent = "Processing...";
            checkoutError.classList.add("hidden");

            const extrasPayload: ExtraSelection[] = [];
            extras.forEach((qty, productId) => {
                if (qty > 0) extrasPayload.push({ productId, quantity: qty });
            });

            try {
                const res = await fetch("/api/checkout", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ box: extrasOnlyMode ? null : selectedBox, extras: extrasPayload, deliveryMethod }),
                });

                const data = await res.json();

                if (!res.ok) {
                    if (res.status === 409 && data.stock) {
                        stockData!.stock = data.stock;
                        updateStockDisplay();
                        updateSummary();
                        checkoutError.textContent = "Some items are no longer available. We've updated the stock counts \u2014 please review your order.";
                    } else {
                        checkoutError.textContent = data.error || "Something went wrong. Please try again.";
                    }
                    checkoutError.classList.remove("hidden");
                    checkoutBtn.textContent = "Proceed to Checkout";
                    updateSummary(); // re-evaluates disabled state based on current selection
                    return;
                }

                if (data.url) {
                    window.location.href = data.url;
                }
            } catch {
                checkoutError.textContent = "Something went wrong. Please try again.";
                checkoutError.classList.remove("hidden");
                checkoutBtn.textContent = "Proceed to Checkout";
                updateSummary();
            }
        });

        fetchStock();
    </script>
</Layout>
