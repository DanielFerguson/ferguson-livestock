---
import { Image } from "astro:assets";
import Layout from "../components/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import boxImage from "../assets/images/box.webp";
import { business } from "../config/business";
import { bundles, formatAud, formatPerKg, products } from "../config/products";
import { getStock, isDropActive } from "../lib/kv";
import { buildBeefBoxStructuredData, buildWebPageSchema } from "../lib/seo";

export const prerender = false;

const title = "Farm-Direct Murray Grey Beef Boxes | Ferguson Livestock";
const description = "Compare Ferguson Livestock’s 5kg and 10kg Murray Grey beef boxes, current prices, typical contents, freezer guidance, delivery and pickup options.";
const pageUrl = `${business.siteUrl}/beef-boxes`;
const fiveKg = products["beef-box-5kg"];
const tenKg = bundles["beef-box-10kg"];

let stockKnown = false;
let active = false;
let stock: Record<string, number> = {};

try {
    [stock, active] = await Promise.all([getStock(), isDropActive()]);
    stockKnown = true;
} catch {
    // Keep the evergreen page useful if live inventory is temporarily unavailable.
}

const boxStock = stock["beef-box-5kg"] ?? 0;
const fiveKgAvailable = active && boxStock > 0;
const tenKgAvailable = active && boxStock >= 2;
const extrasAvailable = active && Object.entries(stock).some(
    ([id, quantity]) => products[id]?.type === "extra" && quantity > 0,
);

const structuredData = stockKnown
    ? buildBeefBoxStructuredData({ pageUrl, title, description, fiveKgAvailable, tenKgAvailable })
    : [buildWebPageSchema({ url: pageUrl, title, description })];

const primaryHref = fiveKgAvailable ? "/order" : extrasAvailable ? "/order" : "/#waitlist";
const primaryLabel = fiveKgAvailable ? "Shop this drop" : extrasAvailable ? "Shop available cuts" : "Join the next drop";
---

<Layout title={title} description={description} structuredData={structuredData}>
    <Header />
    <main id="main-content">
        <section class="bg-forest py-16 text-cream lg:py-24">
            <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 lg:grid-cols-2">
                <div>
                    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-mint-light">Small-batch Murray Grey beef</p>
                    <h1 class="mb-6 font-display text-5xl font-semibold leading-none tracking-tight sm:text-6xl">A box for the way your household cooks.</h1>
                    <p class="max-w-xl text-lg leading-relaxed text-cream/80">A practical mix of steaks, roasts, slow-cook cuts, sausages and mince—professionally prepared, vacuum-sealed and ready for your freezer.</p>
                    <div class="mt-8 flex flex-wrap gap-3">
                        <a href={primaryHref} class="bg-mint px-6 py-3.5 font-semibold text-forest no-underline hover:bg-mint-light">{primaryLabel}</a>
                        <a href="/delivery" class="border border-cream/30 px-6 py-3.5 font-semibold text-cream no-underline hover:border-mint">Delivery &amp; pickup</a>
                    </div>
                </div>
                <Image src={boxImage} alt="Ferguson Livestock Murray Grey beef packed in branded freezer boxes" class="aspect-square w-full object-cover" widths={[500, 720, 960]} sizes="(max-width: 1024px) 100vw, 50vw" />
            </div>
        </section>

        <section class="bg-cream py-16 lg:py-24">
            <div class="mx-auto max-w-6xl px-6">
                <div class="mb-10 max-w-2xl">
                    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-sage">Choose your box</p>
                    <h2 class="font-display text-4xl font-semibold text-forest sm:text-5xl">Straightforward sizes. Honest value.</h2>
                </div>

                <div class="grid gap-8 lg:grid-cols-2">
                    {[{ product: fiveKg, price: fiveKg.price, details: fiveKg.boxDetails!, available: fiveKgAvailable }, { product: tenKg, price: tenKg.displayPrice, details: tenKg.boxDetails, available: tenKgAvailable }].map(({ product, price, details, available }) => (
                        <article class="border border-forest/10 bg-white p-6 sm:p-8">
                            <div class="mb-6 flex items-start justify-between gap-4">
                                <div>
                                    <h3 class="font-display text-3xl font-semibold text-forest">{product.name}</h3>
                                    <p class="mt-1 text-gray-600">{details.bestFor}</p>
                                </div>
                                {stockKnown && <span class:list={["px-3 py-1 text-xs font-semibold uppercase tracking-wider", available ? "bg-mint/25 text-forest" : "bg-cream-dark text-gray-600"]}>{available ? "Available" : "Sold out"}</span>}
                            </div>
                            <div class="mb-6 flex items-end gap-3 border-b border-forest/10 pb-6">
                                <span class="font-display text-5xl font-semibold text-forest">{formatAud(price)}</span>
                                <span class="pb-1 text-sm font-semibold text-sage">{formatPerKg(details.perKgPrice)}</span>
                            </div>
                            <ul class="space-y-3 text-sm leading-relaxed text-gray-700">
                                {details.contents.map((item) => <li class="flex gap-3"><span class="mt-1 text-sage">✓</span><span>{item}</span></li>)}
                            </ul>
                            <p class="mt-6 border-t border-forest/10 pt-5 text-sm text-gray-600">{details.freezerGuidance} Individual cuts vary naturally from animal to animal.</p>
                        </article>
                    ))}
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
